# /etc/flight-runner.env — drone-node(비행 실행기 연동)가 읽는다. install.sh 가 처음 한 번 복사한다.
# 고친 뒤: sudo systemctl restart drone-node   (돌고 있는 비행 스크립트는 영향 없음 — 별도 유닛이다)

# 비행 스크립트를 어디서 띄우나: user(기본, systemd-run --user) · system(root/sudo 필요) · local(시험 전용, 실기 금지)
FLIGHT_RUNNER_SYSTEMD=user
# system 일 때 sudo -n 을 붙이나 (노드가 NoNewPrivileges=yes 라 보통 안 된다)
FLIGHT_RUNNER_SUDO=0

# 스크립트 · 파이썬 · 출력
FLIGHT_RUNNER_PYTHON=/home/physical/drone/venv/bin/python
FLIGHT_RUNNER_SCRIPTS=/home/physical/drone/scripts
FLIGHT_RUNNER_OUT_DIR=/home/physical/cansar_logs/runner

# 감쌀 노드 클래스 (module:Class)
FLIGHT_RUNNER_NODE=drone.drone_node:DroneNode
