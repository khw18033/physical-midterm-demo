# 드론 온보드 노드 설정 — pi3. 설치 위치: /etc/hw-drone.env
# drone-node.service 가 /etc/hw-node.env(공통) 다음에 이 파일을 읽으므로 여기 값이 이긴다.
# 변경 후: sudo systemctl restart drone-node

# ── 식별자 ──────────────────────────────────────────────────────
# /etc/device_id 와 같은 값이지만 명시한다(schema.Identity.resolve 는 환경변수가 우선).
HW_ENTITY_ID=x500-001
# 토픽 2번째 칸. 상태 토픽이 zoneA/drone/x500-001/... 이 된다.
# 구독자는 이 자리를 + 로 받아야 기종이 늘어도 깨지지 않는다.
HW_ENTITY_TYPE=drone
HW_DEVICE_TYPE=x500_drone

# 규약 명령 토픽은 HW_ENTITY_ID 로 정해진다(etype 무관):
#   terminal/x500-001/downlink  (상위 → 드론)
#   terminal/x500-001/uplink    (드론 → 상위)

# ── MAVLink 입력 (읽기 전용) ────────────────────────────────────
# mavlink-router 의 [UdpEndpoint bridge]. 14540(MAVSDK 제어 자리)은 쓰지 않는다.
HW_DRONE_UDP_PORT=14543
# 재사용하는 pi3 스크립트 (is_vehicle_heartbeat, decode_px4_custom_mode)
HW_DRONE_SCRIPTS=/home/physical/drone/scripts
# drone-detect 가 남기는 현재 모드. "FC 링크 없음"의 근거 중 하나.
HW_DRONE_MODE_FILE=/home/physical/drone/state/mode

# ── 보고 주기 ───────────────────────────────────────────────────
# ⚠ systemd EnvironmentFile 은 값 뒤의 주석을 잘라 주지 않는다. 같은 줄에 # 를 쓰면
#   주석까지 값이 된다. 설명은 반드시 윗줄에 적는다.

# 상태 발행 1Hz (요구 1~2Hz)
HW_DRONE_STATE_INTERVAL=1.0
# 이산 사건(링크·arm·모드·배터리 경보) 감지 주기
HW_DRONE_SAMPLE_INTERVAL=0.2
# heartbeat 1Hz → 3회 결번이면 FC 링크 없음으로 본다
HW_DRONE_FC_TIMEOUT=3.0
# % — 배터리 이산 경보 임계
HW_DRONE_BATTERY_WARN=20.0
