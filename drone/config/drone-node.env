# 드론 노드 설정 — /etc/drone-node.env 의 정본 (drone/install_all.sh 가 그 자리에 복사한다)
# drone-detect · drone-mavlink-router · drone-linkmon 유닛이 EnvironmentFile 로 읽는다.
# 이 Pi 에서 ~/drone/config/drone.env 는 /etc/drone-node.env 를 가리키는 심볼릭 링크다.
# 고친 뒤: sudo systemctl restart drone-detect
#
# ★ 새 드론에 깔 때 기체마다 바꿀 값: DRONE_DEVICE_ID(= device_id = hw-drone.env 의 HW_ENTITY_ID),
#   DRONE_TS_NAME / DRONE_TS_IP(그 Pi 의 tailscale ip -4), FC_BAUD(그 FC 의 TELEM2 보율)

# ── FC 연결 (TELEM2 ↔ GPIO14/15) ────────────────────────────────
# 1단계에서 실측 확정:
#   /dev/ttyAMA0 -> 1f00030000.serial = DT uart0 = rp1/serial@30000 = GPIO14/15
#   pinctrl get 14,15 -> GPIO14=TXD0, GPIO15=RXD0
# 주의: /dev/serial0 은 디버그 커넥터(ttyAMA10)를 가리킨다. 쓰지 말 것.
FC_DEVICE=/dev/ttyAMA0
# 2026-10-22: FC TELEM2 가 230400 으로 실측됨. 대체값은 원래 정상값 921600.
FC_BAUD=230400
FC_BAUD_FALLBACK=921600

# ── 장비 식별자 ─────────────────────────────────────────────────
# /etc/device_id 와 같은 값. MQTT clientId 겸용.
# pi7 의 go1-001 / wl-001 과 겹치지 않음.
DRONE_DEVICE_ID=x500-001

# ── 경로 ────────────────────────────────────────────────────────
DRONE_HOME=/home/physical/drone
DRONE_VENV=/home/physical/drone/venv
DRONE_USER=physical
DRONE_ROUTER_CONF=/home/physical/drone/config/mavlink-router.conf

# ── 자동 감지 동작 (drone-detect.service) ───────────────────────
# 감지 1회당 heartbeat 대기 시간(초)
DETECT_TIMEOUT=6
# FC 를 못 찾았을 때 재시도 간격(초)
DETECT_INTERVAL=10
# 시리얼 포트를 놓고 라우터를 띄우기까지 기다리는 시간(초) — 포트 충돌 방지
PORT_RELEASE_DELAY=1.5
# 드론 모드에서 heartbeat 가 이 시간(초) 끊기면 drone.target 을 내리고 감지로 복귀
LINK_TIMEOUT=15
# 시리얼 포트가 계속 점유돼 감지가 막힐 때, 몇 회 연속 건너뛴 뒤 강제로 풀 것인가.
# (2026-09-22 추가) 이게 없으면 FC 가 정상인데도 mode=none 에 영구히 갇힌다.
# 0 = 강제 해제 안 함(옛 동작). 3 이면 약 20~30초 뒤 개입한다.
# 사람이 수동으로 시리얼을 쓸 때는 touch ~/drone/state/maintenance 로 보류시킨다.
STUCK_ESCALATE_AFTER=3
# 재시작 직후 살아 있는 링크를 이어받을지 판단할 때 heartbeat 를 기다리는 시간(초).
# (2026-09-22 추가) 워치독이 감지기를 죽여 다시 띄웠을 때 건강한 링크를 헛되이
# 내렸다 올리지 않게 한다.
ADOPT_TIMEOUT=5

# ── 라우터 엔드포인트 (mavlink-router.conf 와 일치해야 함) ──────
# 14540 = MAVSDK 제어 코드, 14541 = linkmon, 14542 = detect, 5760 = QGC(TCP)
CTRL_UDP_PORT=14540
LINKMON_UDP_PORT=14541
DETECT_UDP_PORT=14542
QGC_TCP_PORT=5760

# ── 지상국 / Tailscale (5단계) ──────────────────────────────────
DRONE_TS_NAME=pi3
DRONE_TS_IP=100.85.243.54
GCS_TS_NAME=desktop-oaujese
GCS_TS_IP=100.125.71.51

# ── MQTT 브로커 (2026-09-21 브리지 작업에서 변경) ───────────────
# 브로커는 pi3 자신이다 — Go1(pi7)과 같이 웹이 라즈베리파이 브로커에 직접 붙는
# 온디바이스 직통 구조라서, 서버도 pi7 도 거치지 않는다.
# 웹(브라우저)은 ws://pi3.local:9001, 말단·도구는 127.0.0.1:1883.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# 바꾸기 전 값 (pi7 브로커). 되돌릴 때 이 줄을 쓴다.
#MQTT_HOST=192.168.50.172
#MQTT_HOST_TS=100.72.109.9
