# 드론 연동 환경 설정 — pi3 (X500 v2 컴패니언 컴퓨터)
# 1단계에서 실측 확정. 이후 모든 단계는 이 값을 쓴다.
# 셸에서: set -a; . ~/drone/config/drone.env; set +a

# ── FC 연결 (TELEM1 ↔ GPIO14/15) ────────────────────────────────
# 실측 근거 (2026-09-21 재부팅 후):
#   /dev/ttyAMA0 -> .../1f00030000.serial = DT uart0 = rp1/serial@30000 = GPIO14/15
#   pinctrl get 14,15 -> GPIO14=TXD0, GPIO15=RXD0
# 주의: /dev/serial0 은 여전히 디버그 커넥터(ttyAMA10)를 가리킨다. 쓰지 말 것.
FC_DEVICE=/dev/ttyAMA0
FC_BAUD=921600

# 921600에서 링크가 안 잡힐 때 시도할 대체 보드레이트 (3단계)
FC_BAUD_FALLBACK=57600

# ── 장비 식별자 ─────────────────────────────────────────────────
# 4단계에서 /etc/device_id 로도 기록한다. MQTT clientId 겸용.
# pi7의 go1-001 / wl-001 과 겹치지 않음.
DRONE_DEVICE_ID=x500-001

# ── 내부 경로 ───────────────────────────────────────────────────
DRONE_HOME=/home/physical/drone
DRONE_VENV=/home/physical/drone/venv

# ── 다음 단계에서 쓸 값 (아직 미사용) ───────────────────────────
# 4단계 mavlink-router: TCP 5760 (QGC), UDP 14540 (로컬 MAVSDK)
# 5단계 Tailscale: 이 장비 pi3 / 100.85.243.54 → QGC는 100.85.243.54:5760
# 5단계 MQTT 브로커 후보 (pi7). 이번 작업에서는 연결하지 않는다.
#MQTT_HOST=192.168.50.172
#MQTT_HOST_TS=100.72.109.9
#MQTT_PORT=1883
