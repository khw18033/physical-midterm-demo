# 피지컬팀 mk2 말단 노드 공통 설정 — pi3 (X500 v2 드론)
# 설치 위치: /etc/hw-node.env   (pi7 의 같은 파일과 같은 결)
# 변경 후: sudo systemctl restart drone-node

# 브로커는 pi3 자신이다. 웹은 ws://pi3.local:9001 로 같은 브로커에 붙는다.
HW_BROKER_HOST=127.0.0.1
HW_BROKER_PORT=1883

# 구역. /etc/zone_id 가 있으면 그 값이 우선한다 (pi7 과 같은 zoneA).
HW_ZONE_ID=zoneA

# 엣지 OTel Collector. 비어 있으면 관측 발신만 꺼지고 노드는 정상 동작한다.
#HW_OTEL_ENDPOINT=http://192.168.50.244:4317

# TLS (엣지 브로커 인증서 준비 후)
#HW_TLS_CA=/etc/hw/ca.crt
