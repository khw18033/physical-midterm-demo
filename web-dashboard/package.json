{
  "name": "hybrid-dt-web-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "가시화 파트 — 데이터 레이어 + 목 게이트웨이 (VZ-I-01~03, VZ-U-01)",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:mock": "node mock-gateway/server.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --force && tsc -p mock-gateway/tsconfig.json",
    "scenario": "node scripts/scenario.mjs",
    "verify:cache": "node scripts/verify-reconnect-cache.mjs",
    "verify:pipeline": "node scripts/verify-pipeline-editor.mjs",
    "verify:mission-graph": "node scripts/verify-mission-graph.mjs",
    "verify:contract-roundtrip": "node scripts/verify-contract-roundtrip.mjs",
    "verify:catalog-derived": "node scripts/verify-catalog-derived.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
