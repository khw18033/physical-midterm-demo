{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "evaluation.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["criteria", "result", "judged_by", "evidence_refs"],
  "properties": {
    "criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "result": { "enum": ["pass", "fail", "inconclusive"] },
    "judged_by": { "enum": ["ai", "backend", "human"] },
    "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
