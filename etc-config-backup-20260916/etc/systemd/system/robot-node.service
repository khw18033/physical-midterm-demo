# 로봇 온보드 노드 부팅 자동 시작 (systemd)
#
# 설치:
#   sudo cp pi/deploy/robot-node.service /etc/systemd/system/
#   sudo cp pi/deploy/hw-node.env.example /etc/hw-node.env   # 현장값 기입
#   sudo systemctl daemon-reload && sudo systemctl enable --now robot-node
#
# 센서노드와 같은 공통 코어를 쓰지만 별도 서비스로 둔다 — 계측 원천·보고 주기·
# 명령 어휘가 다르고, 한쪽 장애가 다른 쪽을 끌고 내려가면 안 되기 때문이다.

[Unit]
Description=피지컬팀 mk2 로봇 온보드 노드
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=simple
User=physical
WorkingDirectory=/home/physical/hw/pi
ExecStart=/home/physical/venv/bin/python3 -u -m robot.robot_node

EnvironmentFile=-/etc/hw-node.env
EnvironmentFile=-/etc/hw-robot.env

# 센서노드와 버퍼 파일을 공유하면 서로의 미전송분을 집어삼킨다. 반드시 분리.
StateDirectory=hw-node
Environment=HW_SPOOL_PATH=/var/lib/hw-node/robot-spool.jsonl
Environment=PYTHONUNBUFFERED=1

# 20Hz 상태 스트림이 폭주 컨테이너에 밀리지 않도록 우선순위를 준다 (SDD 7.3)
OOMScoreAdjust=-500

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
