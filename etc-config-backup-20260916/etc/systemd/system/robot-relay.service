# 로봇 상태 릴레이 — 신원(node_id/robot_type/robot_id)을 찍어 상위로 넘긴다 (HW-R-03)
#
# 설치:
#   sudo cp pi/deploy/robot-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now robot-relay
#
# 왜 별도 프로세스인가
#   "어느 파이가 전달했는가"는 그 파이 자신만 확실히 안다. 발신자(로봇·피더)가 무엇을
#   주장하든 릴레이가 node_id 를 덮어쓴다. 같은 기종·같은 robot_id 가 여러 대 들어와도
#   전달한 파이로 먼저 갈라지므로 충돌하지 않는다(HW-interface/multi-robot-contract.md).
#
# 왜 지금 켜는가 — 로봇↔트윈 결합 해제의 1단계다.
#   지금 Unity 는 go1_sdk_pc 의 직결 UDP(15101)를 받는다. 그 페이로드에는 신원이 없어서
#   로봇을 바꾸거나 늘리면 트윈까지 고쳐야 한다. 이 릴레이 경로(15201)는 신원이 붙어 있어
#   나중에 대상만 "Unity -> 서버"로 바꾸면 그대로 서버 경유가 된다.
#   직결은 살려 둔 채 이중 발신하므로 지금 동작은 아무것도 바뀌지 않는다.
#   (docs/ARCHITECTURE_ALIGNMENT.md §2-3)
#
# 로봇이 없어도 뜬다 — 들어오는 게 없으면 아무것도 안 보낸다. 그래서 부팅 자동시작해도
# 안전하다(go1-sdk 와 달리 로봇을 움직이지 않는다).

[Unit]
Description=Go1 robot state relay (identity stamping -> Unity/server)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=physical
WorkingDirectory=/home/physical/hw/pi
ExecStart=/home/physical/venv/bin/python3 -u /home/physical/hw/pi/robot/robot_state_relay.py \
  --node_id pi7 --unity_ip 192.168.50.244 --unity_port 15201 --ingress_port 15200 \
  --default_type go1 --default_robot_id go1-1
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
