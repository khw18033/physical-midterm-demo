# 로봇 온보드 노드 현장 설정 — /etc/hw-robot.env 로 복사해서 값만 채운다.
# robot-node.service 가 /etc/hw-node.env(공통) 다음에 이 파일을 읽으므로,
# 여기 값이 공통값을 덮어쓴다. 변경 후: sudo systemctl restart robot-node

# 제어기 링크 — go1 이면 Go1 내부 MQTT(192.168.123.161)를 구독해 상태를 읽는다.
HW_CONTROLLER_LINK=go1

# 식별자. 센서노드와 **반드시 달라야 한다**(같은 device_id 로 두 노드가 붙으면
# 같은 client_id 플래핑으로 서로를 끊는다). /etc/device_id(=wl-001)는 센서노드 것이라
# 로봇은 환경변수로 직접 준다 — 파일보다 이쪽이 우선한다(schema.Identity.resolve).
HW_ENTITY_ID=go1-001
HW_ENTITY_TYPE=robot
HW_DEVICE_TYPE=go1_robot

# 규약 명령 토픽은 이 값으로 정해진다:
#   terminal/go1-001/downlink   (상위 → 로봇)
#   terminal/<...>/uplink                           (로봇 → 상위)

# 영상은 명령(stream start)이 오기 전에는 뜨지 않는다. 카메라 미확보면 test 패턴.
#HW_MEDIA_SOURCE=test
HW_DETECT_URL=http://ubuntu3-15ug50p-gp55kn:8000
