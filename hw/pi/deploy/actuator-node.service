# 액추에이터 제어노드 부팅 자동 시작 (systemd)
#
# 설치:
#   sudo cp pi/deploy/actuator-node.service /etc/systemd/system/
#   sudo cp pi/deploy/hw-node.env.example /etc/hw-node.env
#   sudo systemctl daemon-reload && sudo systemctl enable --now actuator-node
#
# 되돌리기 어려운 물리 구동을 다루므로 세 노드 중 가장 보수적으로 설정한다.

[Unit]
Description=피지컬팀 mk2 액추에이터 제어노드 (수문·차수벽·펌프)
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=simple
User=physical
WorkingDirectory=/home/physical/hw/pi
ExecStart=/home/physical/venv/bin/python3 -u -m actuator.actuator_node

EnvironmentFile=-/etc/hw-node.env
EnvironmentFile=-/etc/hw-actuator.env

StateDirectory=hw-node
Environment=HW_SPOOL_PATH=/var/lib/hw-node/actuator-spool.jsonl
Environment=PYTHONUNBUFFERED=1

# 안전 잠금 판정이 밀리면 열린 수문을 닫힘으로 오인할 수 있다. 폭주 컨테이너에
# 굶지 않도록 우선순위를 준다 (SDD 7.3).
OOMScoreAdjust=-700

# 종료 시 안전 상태로 갈 시간을 준다. 급히 죽이면 구동 중 상태로 남는다.
TimeoutStopSec=20
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
