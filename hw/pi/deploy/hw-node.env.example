# 현장 설정 — /etc/hw-node.env 로 복사해서 값만 채운다 (저장소에 현장값을 넣지 않는다)
# 변경 후: sudo systemctl restart sensor-node

# 엣지 브로커 주소 (임시: 노트북 / 최종: 엣지노드)
HW_BROKER_HOST=192.168.50.244
HW_BROKER_PORT=1883

# 구역. /etc/zone_id 파일이 있으면 그 값이 우선한다.
HW_ZONE_ID=zoneA

# 주기 (요구사항 정의서 기본값을 쓰려면 비워둔다)
#HW_HB_INTERVAL=1.0
#HW_REPORT_INTERVAL_NORMAL=60.0

# 엣지 OTel Collector. 비어 있으면 관측 발신만 꺼지고 노드는 정상 동작한다.
#HW_OTEL_ENDPOINT=http://192.168.50.244:4317

# TLS (엣지 브로커 인증서 준비 후)
#HW_TLS_CA=/etc/hw/ca.crt
